pipeline{
    agent{
        label 'worker'
    }

    tools{
        maven 'mvn'
    }

    environment{
        my_aws_cred = credentials('aws-access')
    }

    stages{
        stage('checkout'){
            steps{
                git branch: 'main', url: 'https://github.com/rohitpingale95/EasyCRUD.git'
            }
        }
        stage('Build'){
            steps{
                dir('backend'){
                    sh 'mvn clean package'
                }
            }

            post {
                success {
                    archiveArtifacts artifacts: 'backend/target/*.jar', fingerprint: true
                }
            }
        }

        stage('Artifact to s3'){
            steps{
                sh '''
                    sudo snap install aws-cli --classic
                    aws s3 cp backend/target/*.jar s3://rohitptech.online/Artifact/student.war
                '''
            }
        }

        stage('SonarQube Analysis') {
            steps {
                dir('backend') {
                    withSonarQubeEnv('sonar') {
                        sh 'mvn sonar:sonar'
                    }
                }
            }
        }

        stage('Quality Gates') {
            steps {
                timeout(time: 5, unit: 'MINUTES'){
                    waitForQualityGate abortPipeline: true
                }
            }
        }
        

    }
}