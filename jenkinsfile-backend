pipeline{
    agent{
        label 'worker'
    }

    tools{
        maven 'mvn'
    }

    stages{
        stage('checkout'){
            steps{
                git branch: 'main', url: 'https://github.com/rohitpingale95/EasyCRUD.git'
            }
        }
        stage('Build'){
            steps{
                dir('backend'){
                    sh 'mvn clean package'
                }
            }
        }
    }
}